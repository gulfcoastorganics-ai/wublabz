FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg rubberband-cli \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY src/flip-worker/python/requirements.txt ./src/flip-worker/python/requirements.txt
RUN pip3 install --break-system-packages -r ./src/flip-worker/python/requirements.txt

COPY . .

ENV FLIP_WORKER_HOST=0.0.0.0
ENV FLIP_WORKER_PORT=3002
ENV SEPARATOR=local

EXPOSE 3002
CMD ["npm", "run", "flip-worker"]
